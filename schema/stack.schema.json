{
  "$defs": {
    "StackComponent": {
      "properties": {
        "recipe": {
          "description": "Recipe name, as in recipes/<name>/<version>/recipe.yaml",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Recipe",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recipe version (default: the highest version available)",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Version"
        }
      },
      "required": [
        "recipe"
      ],
      "title": "StackComponent",
      "type": "object"
    },
    "TestConfig": {
      "properties": {
        "command": {
          "description": "Command to execute inside container to verify functionality",
          "title": "Command",
          "type": "string"
        },
        "expected_checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected SHA-256 of output_file",
          "pattern": "^\\s*[0-9a-fA-F]{64}\\s*$",
          "title": "Expected Checksum"
        },
        "expected_exit_code": {
          "default": 0,
          "description": "Expected process exit code",
          "title": "Expected Exit Code",
          "type": "integer"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Substring expected in stdout/stderr",
          "title": "Expected Output"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input files written to the test working directory /test (relative path -> inline content)",
          "title": "Files",
          "type": "object"
        },
        "output_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File (relative to /test) the command must produce",
          "title": "Output File"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exported as CAPSID_RANDOM_SEED and PYTHONHASHSEED for deterministic runs",
          "title": "Random Seed"
        },
        "timeout": {
          "default": 60,
          "description": "Seconds before the test is aborted",
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "title": "TestConfig",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/LaBiOmicS/capsid-hub/main/schema/stack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apt_snapshot": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "snapshot.debian.org timestamp or 'latest'",
      "pattern": "^(\\d{8}T\\d{6}Z|latest)$",
      "title": "Apt Snapshot"
    },
    "components": {
      "description": "List of recipes included in this stack",
      "items": {
        "$ref": "#/$defs/StackComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Description of the combined container",
      "title": "Description"
    },
    "name": {
      "description": "Stack container name, e.g. 'rnaseq-toolkit'",
      "title": "Name",
      "type": "string"
    },
    "test": {
      "$ref": "#/$defs/TestConfig",
      "description": "Test command verifying all tools work"
    },
    "version": {
      "description": "Stack release version, e.g. '1.0.0'",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "components",
    "test"
  ],
  "title": "Capsid stack (stacks/<name>.yaml)",
  "type": "object"
}
