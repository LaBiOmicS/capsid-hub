{
  "$defs": {
    "BuildConfig": {
      "properties": {
        "apt_snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "snapshot.debian.org timestamp (YYYYMMDDTHHMMSSZ) for apt packages; 'latest' disables the snapshot. Defaults to Capsid's pinned snapshot when base_image is not overridden",
          "pattern": "^(\\d{8}T\\d{6}Z|latest)$",
          "title": "Apt Snapshot"
        },
        "base_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Runtime (and source/uv builder) base image, ideally pinned by @sha256 digest",
          "title": "Base Image"
        },
        "binary_url_amd64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Precompiled binary or archive URL for linux/amd64 (type: binary)",
          "title": "Binary Url Amd64"
        },
        "binary_url_arm64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Precompiled binary or archive URL for linux/arm64 (type: binary)",
          "title": "Binary Url Arm64"
        },
        "build_commands": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shell commands that replace the default build steps, run in the unpacked source (source types and binary)",
          "title": "Build Commands"
        },
        "cargo_args": {
          "description": "Extra arguments for cargo install (type: rust-cargo)",
          "items": {
            "type": "string"
          },
          "title": "Cargo Args",
          "type": "array"
        },
        "channels": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Conda channels, in priority order",
          "title": "Channels"
        },
        "cmake_args": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Extra arguments for the cmake configure step (type: cmake)",
          "title": "Cmake Args"
        },
        "conda_packages": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Conda match specs, e.g. 'samtools==1.25' (type: pixi-conda)",
          "title": "Conda Packages"
        },
        "configure_args": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Extra arguments for ./configure (type: autotools)",
          "title": "Configure Args"
        },
        "dependencies": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Debian packages: 'build' installed in the builder stage, 'run' in the runtime image",
          "title": "Dependencies",
          "type": "object"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables set in the runtime image",
          "title": "Env",
          "type": "object"
        },
        "install_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Installation prefix copied to the runtime image (default: /opt/<name>)",
          "title": "Install Prefix"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PyPI requirement, e.g. 'cutadapt==5.2' (type: uv-pypi)",
          "title": "Package"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "3.12",
          "description": "Python version of the virtual environment (type: uv-pypi)",
          "title": "Python Version"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the source archive; required with 'source'",
          "pattern": "^\\s*[0-9a-fA-F]{64}\\s*$",
          "title": "Sha256"
        },
        "sha256_amd64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA256 of binary_url_amd64",
          "pattern": "^\\s*[0-9a-fA-F]{64}\\s*$",
          "title": "Sha256 Amd64"
        },
        "sha256_arm64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA256 of binary_url_arm64",
          "pattern": "^\\s*[0-9a-fA-F]{64}\\s*$",
          "title": "Sha256 Arm64"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source archive URL (types: autotools, cmake, make, rust-cargo)",
          "title": "Source"
        },
        "source_date_epoch": {
          "default": 1700000000,
          "description": "SOURCE_DATE_EPOCH passed to BuildKit for deterministic image timestamps",
          "title": "Source Date Epoch",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/BuildType",
          "description": "Build engine and strategy"
        }
      },
      "required": [
        "type"
      ],
      "title": "BuildConfig",
      "type": "object"
    },
    "BuildType": {
      "enum": [
        "uv-pypi",
        "pixi-conda",
        "autotools",
        "cmake",
        "make",
        "binary",
        "rust-cargo"
      ],
      "title": "BuildType",
      "type": "string"
    },
    "Platform": {
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ],
      "title": "Platform",
      "type": "string"
    },
    "TestConfig": {
      "properties": {
        "command": {
          "description": "Command to execute inside container to verify functionality",
          "title": "Command",
          "type": "string"
        },
        "expected_checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected SHA-256 of output_file",
          "pattern": "^\\s*[0-9a-fA-F]{64}\\s*$",
          "title": "Expected Checksum"
        },
        "expected_exit_code": {
          "default": 0,
          "description": "Expected process exit code",
          "title": "Expected Exit Code",
          "type": "integer"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Substring expected in stdout/stderr",
          "title": "Expected Output"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input files written to the test working directory /test (relative path -> inline content)",
          "title": "Files",
          "type": "object"
        },
        "output_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File (relative to /test) the command must produce",
          "title": "Output File"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exported as CAPSID_RANDOM_SEED and PYTHONHASHSEED for deterministic runs",
          "title": "Random Seed"
        },
        "timeout": {
          "default": 60,
          "description": "Seconds before the test is aborted",
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "title": "TestConfig",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/LaBiOmicS/capsid-hub/main/schema/recipe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "build": {
      "$ref": "#/$defs/BuildConfig"
    },
    "categories": {
      "description": "Topic/category tags (e.g. genomics, transcriptomics)",
      "items": {
        "type": "string"
      },
      "title": "Categories",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "One-line summary of tool function",
      "title": "Description"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Persistent Digital Object Identifier (DOI) for tool or paper",
      "title": "Doi"
    },
    "edam_operations": {
      "description": "EDAM ontology operation IDs, e.g. ['operation_0573']",
      "items": {
        "type": "string"
      },
      "title": "Edam Operations",
      "type": "array"
    },
    "edam_topics": {
      "description": "EDAM ontology topic IDs, e.g. ['topic_0080']",
      "items": {
        "type": "string"
      },
      "title": "Edam Topics",
      "type": "array"
    },
    "homepage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Official project homepage or repository",
      "title": "Homepage"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional OCI image labels",
      "title": "Labels",
      "type": "object"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SPDX license identifier, e.g. 'MIT', 'GPL-3.0-or-later'",
      "title": "License"
    },
    "name": {
      "description": "Tool name, lowercase; also the image name and recipes/<name>/ directory",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Name",
      "type": "string"
    },
    "platforms": {
      "description": "Target architectures",
      "items": {
        "$ref": "#/$defs/Platform"
      },
      "title": "Platforms",
      "type": "array"
    },
    "ro_crate": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Extra JSON-LD properties merged into the RO-Crate root Dataset (e.g. author, funder)",
      "title": "Ro Crate"
    },
    "test": {
      "$ref": "#/$defs/TestConfig"
    },
    "version": {
      "description": "Tool version; also the image tag and recipes/<name>/<version>/ directory",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "build",
    "test"
  ],
  "title": "Capsid recipe (recipes/<tool>/<version>/recipe.yaml)",
  "type": "object"
}
